# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# EXPO_PUBLIC_ values are inlined into the JS bundle in plain text and can be
# extracted from any build of the app. That is fine for a personal build on
# your own phone. Before any wider distribution this call has to move behind a
# server that holds the key.
#
# Leave this unset and the app simply skips the voice step.
EXPO_PUBLIC_OPENAI_API_KEY=
